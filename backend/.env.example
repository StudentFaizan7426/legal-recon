# Application Settings
APP_NAME=Legal Recon
APP_VERSION=0.1.0
DEBUG=True
ENVIRONMENT=development

# Server Settings
HOST=0.0.0.0
PORT=8000
WORKERS=1

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# FastAPI Documentation
OPENAPI_URL=/api/openapi.json
DOCS_URL=/api/docs
REDOC_URL=/api/redoc

# CORS Settings
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080","http://localhost:5173"]
CORS_CREDENTIALS=True
CORS_METHODS=["*"]
CORS_HEADERS=["*"]

# NLP Settings
NLP_MODEL_PATH=models/
URDU_TOKENIZER_PATH=models/urdu_tokenizer
NER_MODEL_PATH=models/ner_model

# Database (for future use)
DATABASE_URL=sqlite:///./legal_recon.db

# Processing Settings
MAX_TEXT_LENGTH=50000
PROCESSING_TIMEOUT=300

# API Settings
API_V1_PREFIX=/api/v1
